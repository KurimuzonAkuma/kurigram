# Copy to .env.test (git-ignored) and fill in real values to run the WEB
# proxy integration tests. Every value below is an obviously fake
# placeholder - none of it works as-is.

# Hosted relay to test against.
WEB_PROXY_TEST_HOSTNAME=relay.example.com
# Plain 16-byte secret, or dd-prefixed 17-byte secret, as hex.
WEB_PROXY_TEST_SECRET=000102030405060708090a0b0c0d0e0f
WEB_PROXY_TEST_DC_ID=2

# Your own api_id/api_hash from https://my.telegram.org - never Telegram
# Desktop's published pair, which is not yours to use.
WEB_PROXY_TEST_API_ID=0
WEB_PROXY_TEST_API_HASH=00000000000000000000000000000000
